@using RevendTout.ViewModels
@model PanierViewModel

@{
    ViewData["Title"] = "Panier";
}

@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@TempData["ValidateMessage"]</p>
}

<div>
    <a asp-area="" asp-controller="produit" asp-action="Index" class="btn_vert">Retour</a>
</div>
<br />
<h1>Mon panier</h1>
<br />

@if (Model.TotalArticles > 0)
{
    <section>
        <div class="bloc_produit">
            @foreach (var item in Model.Produits)
            {
                <div class="card_produit">

                    @{
                        var premiereImage = item.Key.Images.OrderBy(img => img.Id).FirstOrDefault();
                        string urlImage = premiereImage != null ? premiereImage.Url : "/images/image_defaut_produit.webp";
                    }
                    <img class="img_prod" src="@urlImage" alt="Image du produit @item.Key.Nom" />

                    <div class="bloc_donnees">
                        <div class="bloc_donnees_1">
                            <div class="c_verte prix_sr">@item.Key.Nom</div>

                            @if (item.Key.Reduction != 0)
                            {
                                if (item.Value > 1)
                                {
                                    decimal? reduc = (item.Key.Prix - item.Key.Reduction) * item.Value;
                                    decimal nb_quantite_decimale = Convert.ToDecimal(item.Value);
                                    decimal? prix_quantite = nb_quantite_decimale * item.Key.Prix;

                                    <div class="prix">
                                        <div class="c_rouge">@reduc&#8364;</div>
                                        <div class="text-barre">@prix_quantite&#8364;</div>
                                    </div>
                                }
                                else
                                {
                                    decimal? reduc = (item.Key.Prix - item.Key.Reduction) * item.Value;
                                    <div class="prix">
                                        <div class="c_rouge">@reduc&#8364;</div>
                                        <div class="text-barre">@item.Key.Prix&#8364;</div>
                                    </div>
                                }
                            }
                            else
                            {
                                if (item.Value > 1)
                                {
                                    decimal nb_quantite_decimale = Convert.ToDecimal(item.Value);
                                    decimal? prix_quantite = nb_quantite_decimale * item.Key.Prix;

                                    <div class="prix_sr">@prix_quantite&#8364;</div>
                                }
                                else
                                {
                                    <div class="prix_sr">@item.Key.Prix&#8364;</div>
                                }
                            }
                        </div>

                        <div class="bloc_donnees_1">
                            <div>
                                Taille : <span class="c_verte"> @item.Key.Tailles?.FirstOrDefault()?.Nom</span>
                            </div>
                        </div>


                        <div class="bloc_donnees_1">
                            <div class="bloc_quantite">
                                <form asp-controller="Panier" asp-action="DiminuerQuantite" asp-route-id="@item.Key.Id" method="post" class="form-produit">
                                    <input type="submit" value="-" class="btn_quantite" />
                                </form>

                                <div class="quantite">@item.Value</div>

                                <form asp-controller="Panier" asp-action="AugmenterQuantite" asp-route-id="@item.Key.Id" method="post" class="form-produit">
                                    <input type="submit" value="+" class="btn_quantite" />
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="bloc_recap">
            <h3 class="text-center c_noir">Récapitulatif</h3>
            <br />
            <div class="recap_prix">
                <div class="c_noir">Sous_total (@Model.TotalArticles articles)</div>
                <div class="c_noir">@Model.TotalPrix &#8364;</div>
            </div>
            <hr />
            <div>
                <div class="recap_prix">
                    <div class="c_noir">Frais de livraison</div>
                    <div class="c_noir">Offert</div>
                </div>
                <br />

                <div class="recap_prix">
                    <div class="c_noir  fs-3">Total à payer</div>
                    <div class="c_verte bolder fs-3">@Model.TotalPrix &#8364;</div>
                </div>
                <br />

                <div class="c_noir">Vous économisez <span class="c_rouge"> @Model.TotalReduction&#8364;</span></div>
                <br />

                <hr />
                <br />
                <div class="c_noir">
                    <input type="checkbox" name="pro" id="pro" value="1" checked="checked" />
                    <label for="pro"> J'accepte les conditions générales de vente</label>
                </div>
                <hr />
                <br />
                <form asp-controller="Panier" asp-action="Paiement" method="post" class="form_recap">
                    <input type="submit" value="Validez mon panier" class="btn_recap" />
                </form>
            </div>
        </div>
    </section>
}
else
{
    <h2 class="c_verte text-center"> Votre panier est vide</h2>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
