@using RevendTout.ViewModels
@model List<CommandeViewModel>

@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@TempData["ValidateMessage"]</p>
}
<div>
    <a asp-area=""
       asp-controller="produit"
       asp-action="Index"
       class="btn_vert">
        Retour
    </a>
</div>


<br />

<section>

    <div>
        <h3 class="c_noir">Mes commandes</h3>

        <br />

        <table>
            <tr>
                <th>Numéro</th>
                <th>Date</th>
                <th>Nombre articles</th>
                <th>Montant</th>
            </tr>
            @foreach (var item in Model)
            {
                if (item.Statut == "En cours")
                {

                    <tr>
                        <td>N°@item.Numero - @item.Statut</td>
                        <td>@item.Date</td>
                        <td>@item.NombreArticles</td>
                        <td>@item.Montant</td>
                        
                    </tr>
                    <tr>
                        <th colspan="4" class="c_verte">Livraison approximative : <span class="c_noir" id="jour"> jours</span>  </th>

                    </tr>
                }

            }
           
        </table>

    </div>
    <br />
    <hr />

    <h5 class="c_noir">Commande finalisées</h5>

    <div>

        <table>
            <tr>
                <th>Numéro</th>
                <th>Date</th>
                <th>Nombre articles</th>
                <th>Montant</th>
            </tr>
            @foreach (var item in Model)
            {
                if (item.Statut == "Validée")
                {

                    <tr>
                        <td>N°@item.Numero - @item.Statut</td>
                        <td>@item.Date</td>
                        <td>@item.NombreArticles</td>
                        <td>@item.Montant</td>
                    </tr>
                }
            }
        </table>

    </div>


</section>

<script src="~/js/site.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        DateLivraison("@ViewData["zipCode"]");
    });
</script>