@model List<Categorie>
@{
    ViewData["Title"] = "Liste_categories";
}

<h1>Liste des catégories</h1>

<div class="actions_top">
    <a asp-area=""
       asp-controller="Categorie"
       asp-action="Nouveau"
       class="btn_vert">
        + Ajouter une catégorie
    </a>
</div>

<table>
    <thead>
        <tr>
            <th scope="col">Nom</th>
            <th scope="col">Description</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categorie in Model!)
        {
            <tr>
                <th scope="row">@categorie.Nom</th>
                <td>@categorie.Description</td>
                <td>
                    <a asp-area=""
                       asp-controller="Categorie"
                       asp-action="Detail"
                       asp-route-id="@categorie.Id"
                       class="link-success">
                        Détail
                    </a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3"></th>
        </tr>
    </tfoot>
</table>
