@model Categorie // la vue s'attend à recevoir unz catégorie

@{
    ViewData["Title"] = "Détail de la catégorie";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="~/admin_index.css" asp-append-version="true" />
}

@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@TempData["ValidateMessage"]</p>
}
<div>
    <a asp-area=""
       asp-controller="Categorie"
       asp-action="Index"
       class="btn_vert">
        Retour
    </a>
</div>
<br />

<h1>Détail de la catégorie : <span class="c_verte">@Model.Nom</span></h1>

<section class="cont_cat">

    <article class="card">

        <section class="div_desc">
            <h2>
                Nom de la catégorie :
                <span class="c_verte">@Model.Nom</span>
            </h2>

            <p class="desc_cat">
                @Model.Description
            </p>

            <div>
            <a asp-area=""
               asp-controller="Categorie"
               asp-action="Modifier"
               asp-route-id="@Model.Id"
               class="btn_vert">
                Modifier la catégorie
                </a>
                <a asp-area=""
                   asp-controller="Categorie"
                   asp-action="Supprimer"
                   asp-route-id="@Model.Id"
                   class="btnSuppr btn_rouge">
                    Supprimer la catégorie
                </a>
            </div>
        </section>

    </article>

</section>