@using RevendTout.ViewModels
@model EditionProduitViewModel


@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p>@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p>@TempData["ValidateMessage"]</p>
}



<h1>@Model.TitreAction</h1>
<br />
<div class="cont_prod">
    <form asp-controller="Produit" asp-action="@Model.ActionType" method="post" class="form-produit">
        <div>
            <label class="c_verte" asp-for="@Model.Nom"></label>
            <br />
            <input asp-for="@Model.Nom" placeholder="Nom du produit" />
            <span asp-validation-for="@Model.Nom" class="text-danger"></span>
        </div>
        <br />  
        <div>
            <label class="c_verte" asp-for="@Model.Desc_courte"></label> 
            <br />
            <input asp-for="@Model.Desc_courte" placeholder="Description courte" />
            <span asp-validation-for="@Model.Desc_courte" class="text-danger"></span>
        </div>
        <br />
        <div>
            <label class="c_verte" asp-for="@Model.Description"></label>
            <br />

            <textarea class="text" asp-for="@Model.Description"
                      placeholder="Description longue"
                      rows="3">
            </textarea>

            <span asp-validation-for="@Model.Description" class="text-danger"></span>
        </div>

        <br />
        <div>
            <label class="c_verte" asp-for="@Model.Prix"></label>
            <br />
            <input asp-for="@Model.Prix" placeholder="Prix" />
            <span asp-validation-for="@Model.Prix" class="text-danger"></span>
        </div>
        <br />
        <div>
            <label class="c_verte" asp-for="@Model.Reduction"></label>
            <br />
            <input asp-for="@Model.Reduction" placeholder="Reduction" />
            <br />
            <span asp-validation-for="@Model.Reduction" class="text-danger"></span>
        </div>
        <br />
        <div>
            <label class="c_verte" asp-for="@Model.Quantite"></label>
            <br />
            <input asp-for="@Model.Quantite" placeholder="Quantite" />
            <span asp-validation-for="@Model.Quantite" class="text-danger"></span>
        </div>


        <br />

        <label class="c_verte" asp-for="@Model.Categories"></label>
        <br />
        <div class="checkbox-scroll">
            @for (int i = 0; i < Model.Categories.Count; i++)
            {
                var cat = Model.Categories[i];
                <div>
                    <input type="checkbox"
                           id="cat_@i"
                           name="CategorieIds"
                           value="@cat.Value"
                           @(Model.CategorieIds != null && Model.CategorieIds.Contains(int.Parse(cat.Value)) ? "checked" : "") />
                    <label for="cat_@i">@cat.Text</label>
                </div>
            }

        </div>


        @* input de type caché,a vec les valeurs de ces 2 type, qui permets de les envoyer pour verifier si l'isbn est déjà utilisé ou pas  *@
        <input type="hidden" asp-for="@Model.ActionType" />
        <input type="hidden" asp-for="@Model.id" />

        <input type="submit" value="Envoyer" class="btn-bg-vert" style="margin-top: 15px;" />
    </form>

    <div class="carousel">

        <!-- Boutons radio (invisibles) -->
        <input type="radio" name="carousel" id="img1" checked>
        <input type="radio" name="carousel" id="img2">
        <input type="radio" name="carousel" id="img3">

        <!-- Images -->
        <div class="carousel-images">
            <img src="/images/teeshirt_homme.webp" alt="Image 1">
            <img src="/images/teeshirt_homme.webp" alt="Image 2">
            <img src="/images/teeshirt_homme.webp" alt="Image 3">
        </div>

        <!-- Boutons -->
        <div class="carousel-buttons">
            <label for="img1"></label>
            <label for="img2"></label>
            <label for="img3"></label>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
