@model List<Produit>
@{
    ViewData["Title"] = "Liste_produits";
    Layout = "_LayoutAdmin";
}
@section Styles {
    <link rel="stylesheet" href="~/admin_index.css" asp-append-version="true" />
}
@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p class="c_rouge">@TempData["ValidateMessage"]</p>
}


<div class="bloc_donnees">
    <h1>Liste des Produits</h1>

    <div class="actions_top">
        <a asp-area=""
           asp-controller="Produit"
           asp-action="Nouveau"
           class="btn_vert">
            + Ajouter un produit
        </a>
    </div>

    <table>
        <thead>
            <tr>
                <th scope="col">Nom</th>
                <th scope="col">Description</th>
                <th scope="col">prix</th>
                <th scope="col">Quantite</th>
                <th scope="col">Nb vente</th>
                <th scope="col">Afficher</th>
                <th scope="col">Modifier</th>
                <th scope="col">Archiver</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var produit in Model!)
            {
                <tr>
                    @if (produit.Archive == true)
                    {
                        <th class="bg_rouge" scope="row">@produit.Nom</th>
                        <td class="bg_rouge">@produit.Desc_courte</td>
                        <td class="bg_rouge">@produit.Prix&euro;</td>
                        <td class="bg_rouge">@produit.Quantite</td>
                        <td class="bg_rouge">@produit.Score_vente</td>
                        <td class="bg_rouge">
                            <a asp-area=""
                               asp-controller="Produit"
                               asp-action="Admin_Index_Detail"
                               asp-route-id="@produit.Id"
                               class="link-success">
                                Détail
                            </a>
                        </td>

                        <td class="bg_rouge">
                            <a asp-area=""
                               asp-controller="Produit"
                               asp-action="Modifier"
                               asp-route-id="@produit.Id"
                               class="link-success">
                                Modifier
                            </a>
                        </td>


                        <td scope="col" class="bg_rouge">
                            <div class="c_verte"><img width="18" height="18" src="https://img.icons8.com/parakeet/18/checked-checkbox--v1.png" alt="checked-checkbox--v1" /> archivé</div>
                        </td>
                    }   
                    else
                    {
                        <th scope="row">@produit.Nom</th>
                        <td>@produit.Desc_courte</td>
                        <td>@produit.Prix&euro;</td>
                        <td>@produit.Quantite</td>
                        <td>@produit.Score_vente</td>
                        <td>
                            <a asp-area=""
                               asp-controller="Produit"
                               asp-action="Admin_Index_Detail"
                               asp-route-id="@produit.Id"
                               class="link-success">
                                Détail
                            </a>
                        </td>

                        <td>
                            <a asp-area=""
                               asp-controller="Produit"
                               asp-action="Modifier"
                               asp-route-id="@produit.Id"
                               class="link-success">
                                Modifier
                            </a>
                        </td>

                        <td scope="col">
                            <a asp-area=""
                               asp-controller="Produit"
                               asp-action="Archiver"
                               asp-route-id="@produit.Id"
                               class="btn_archive link-success">
                                Archiver
                            </a>
                        </td>
                    }


                </tr>

            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="8"></th>
            </tr>
        </tfoot>
    </table>
</div>