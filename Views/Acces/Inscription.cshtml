@using RevendTout.ViewModels
@model InscriptionViewModel


@{
    ViewData["Title"] = "Création de compte";
}
@if (ViewData.ContainsKey("ValidateMessage"))
{
    <p>@ViewData["ValidateMessage"]</p>
}
@if (TempData.ContainsKey("ValidateMessage"))
{
    <p>@TempData["ValidateMessage"]</p>
}



<h1>Bienvenue chez RevendTout <img width="38" height="38" src="https://img.icons8.com/emoji/48/waving-hand-emoji.png" alt="waving-hand-emoji" /></h1>
<p class="c_verte slogan">Vente de vêtements et accessoires</p>

<hr />
<section>

    <form asp-action="Inscription" asp-controller="Acces" method="post">
        <div class="cont_prod">
            <div>
                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Nom"></label>
                    <input class="input_style" asp-for="@Model.Nom" placeholder="Nom" />
                    <span asp-validation-for="@Model.Nom" class="text-danger"></span>
                </div>
                <br />
                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Prenom"></label>
                    <input class="input_style" asp-for="@Model.Prenom" placeholder="Prenom" />
                    <span asp-validation-for="@Model.Prenom" class="text-danger"></span>
                </div>
                <br />

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Adresse!.NumeroRue"></label>
                    <input class="input_style" asp-for="@Model.Adresse!.NumeroRue" placeholder="Numéro de rue" />
                    <span asp-validation-for="@Model.Adresse!.NumeroRue" class="text-danger"></span>
                </div>
                <br />

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Adresse!.NomRue"></label>
                    <input class="input_style" asp-for="@Model.Adresse!.NomRue" placeholder="Nom de rue" />
                    <span asp-validation-for="@Model.Adresse!.NomRue" class="text-danger"></span>
                </div>
                <br />

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Adresse!.CodePostal"></label>
                    <input class="input_style" asp-for="@Model.Adresse!.CodePostal" placeholder="Code postal" />
                    <span asp-validation-for="@Model.Adresse!.CodePostal" class="text-danger"></span>
                </div>

                <br />
            </div> 
            <div>

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Adresse!.Ville"></label>
                    <input class="input_style" asp-for="@Model.Adresse!.Ville" placeholder="Ville" />
                    <span asp-validation-for="@Model.Adresse!.Ville" class="text-danger"></span>
                </div>
                <br />

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Adresse!.Pays"></label>
                    <input class="input_style" asp-for="@Model.Adresse!.Pays" placeholder="Pays" />
                    <span asp-validation-for="@Model.Adresse!.Pays" class="text-danger"></span>
                </div>
                <br />

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.Email"></label>
                    <input class="input_style" asp-for="@Model.Email" placeholder="Mail" />
                    <span asp-validation-for="@Model.Email" class="text-danger"></span>
                </div>
                <br />

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.MotDePasse"></label>
                    <input class="input_style" asp-for="@Model.MotDePasse" placeholder="Mot de passe" type="password" />
                    <span asp-validation-for="@Model.MotDePasse" class="text-danger"></span>
                </div>

                <br />

                <div class="bloc_contenu">
                    <label class="c_verte" asp-for="@Model.ConfirmMotDePasse"></label>
                    <input class="input_style" asp-for="@Model.ConfirmMotDePasse" placeholder="Confirmer le mot de passe" type="password" />
                    <span asp-validation-for="@Model.ConfirmMotDePasse" class="text-danger"></span>
                </div>
                <br />
            </div>
        </div>
        <hr />
        <div class="bloc_btn">
            <input type="submit" value="Créer mon compte" class="btn-bg-vert" />
            <input type="reset" value="Annuler" class="btn-bg-rouge" />
        </div>
        <br />
    </form>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}